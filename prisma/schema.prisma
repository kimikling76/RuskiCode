generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model BookJob {
  id String @id @default(uuid())
  projectId String
  status String @default("queued")
  state Json
  error String?
  revision Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artifacts BookArtifact[]
  @@index([projectId, createdAt])
}
model BookArtifact {
  id String @id @default(uuid())
  bookId String
  book BookJob @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name String
  mime String
  data Bytes
  createdAt DateTime @default(now())
  @@unique([bookId, name])
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role String @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  @@map("user")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
  @@map("session")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@map("account")
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}
model StudioSetup {
  id Int @id
  token String
  createdAt DateTime @default(now())
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
  @@map("rateLimit")
}

/// One synced record of the team's work (a chat, a book, an assistant…), one row per kind and key.
/// `version` detects conflicting edits from two computers; `seq` orders changes for incremental pulls.
model SyncItem {
  userId    String
  kind      String
  key       String
  data      Json?
  deleted   Boolean  @default(false)
  version   Int      @default(1)
  seq       BigInt
  device    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@id([userId, kind, key])
  @@index([userId, seq])
  @@map("sync_item")
}

/// Files referenced by synced records (book images), stored once per content hash.
model SyncAsset {
  userId    String
  hash      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  @@id([userId, hash])
  @@map("sync_asset")
}

/// Paid generation requests by client request id, so a retried request returns the tasks already created
/// instead of creating (and paying for) new ones.
model GenerationRequest {
  requestId String   @id
  userId    String
  model     String
  status    String
  taskIds   Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  @@index([userId, createdAt])
  @@map("generation_request")
}
