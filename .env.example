# Server only; never prefix provider secrets with NEXT_PUBLIC_.
KIE_API_KEY=
# Used in later phases; no connection or billing in Phase 1.
DATABASE_URL=
REDIS_URL=

# KIE text chat; model IDs are configured in src/lib/ai/catalog.ts.
# Access code shared by the two owners; set a long, random value.
STUDIO_ACCESS_CODE=
# Required for production rate limiting. No service is automatically purchased.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional direct providers: choose a supported model ID from their live catalog.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Optional server-configured OpenAI-compatible endpoint (never accepted from the client).
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_CHAT_URL=

# Phase 6: Postgres/Prisma and an always-running BullMQ worker.
# REDIS_URL must be a TCP Redis connection, not the Upstash REST URL.
PUBLIC_APP_URL=https://www.ruskicode.com
ARTIFACT_SIGNING_SECRET=
# Restrict generated image downloads to explicitly trusted provider hosts.
ASSET_ALLOWED_HOSTS=file.aiquickdraw.com
# Worker runtime tools (Docker supplies these).
CHROMIUM_EXECUTABLE_PATH=
BOOK_FONT_FILE=
PDFTOPPM_PATH=
