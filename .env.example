# Server only; never prefix provider secrets with NEXT_PUBLIC_.
KIE_API_KEY=
# Used in later phases; no connection or billing in Phase 1.
DATABASE_URL=
REDIS_URL=

# KIE text chat; model IDs are configured in src/lib/ai/catalog.ts.
# Access code shared by the two owners; set a long, random value.
STUDIO_ACCESS_CODE=
# Required for production rate limiting. No service is automatically purchased.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional direct providers: choose a supported model ID from their live catalog.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_API_KEY=
GOOGLE_MODEL=
# Optional server-configured OpenAI-compatible endpoint (never accepted from the client).
COMPATIBLE_API_KEY=
COMPATIBLE_MODEL=
COMPATIBLE_CHAT_URL=

# Phase 6: Postgres/Prisma and an always-running BullMQ worker.
# REDIS_URL must be a TCP Redis connection, not the Upstash REST URL.
PUBLIC_APP_URL=https://www.ruskicode.com
ARTIFACT_SIGNING_SECRET=
# Generated files are downloaded only from Kie's result hosts (file. and tempfile.aiquickdraw.com).
# Extra trusted hosts, comma separated (optional).
ASSET_ALLOWED_HOSTS=
# Worker runtime tools (Docker supplies these).
CHROMIUM_EXECUTABLE_PATH=
BOOK_FONT_FILE=
PDFTOPPM_PATH=

# Free-tier serverless execution (no persistent BullMQ worker/REDIS_URL needed).
# Use Neon Free for DATABASE_URL, including sslmode=require and connection_limit=2.
BOOK_EXECUTOR=inngest
# Inngest Free account: event key sends jobs; signing key verifies callbacks.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only: INNGEST_DEV=1, plus npx inngest-cli@latest dev.
# UPSTASH_REDIS_REST_URL/TOKEN remain required for distributed rate limiting.

# Shared private account (Better Auth, stored in the existing Neon database).
# Generate a separate random secret of at least 32 characters.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://www.ruskicode.com
# STUDIO_ACCESS_CODE is now used ONLY for the one-time first-account setup.
# Public email signup is disabled. Set the shared email/password privately at /login.

# Optional private Google login: all three values are required to show the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STUDIO_GOOGLE_EMAIL=

# Stirling PDF: page tools for imported PDFs in PDF Studio. Server only (never NEXT_PUBLIC_).
# A Stirling Cloud API key (Settings → Developer → API Keys at stirling.com) or the key of your own server.
# Each file Stirling processes uses credits (Stirling Cloud: 1,000 free per month). Nothing is bought automatically.
STIRLING_API_KEY=
# Optional: the https address of your own Stirling server. Empty = Stirling Cloud (https://api.stirling.com).
STIRLING_API_URL=
